# Volcengine Ark API key for chat/vision (Agent Plan)
# Get one at: https://www.volcengine.com/activity/agentplan
ARK_API_KEY=

# Optional: override the default Ark Agent Plan base URL
# Default: https://ark.cn-beijing.volces.com/api/plan/v3
# ARK_BASE_URL=

# Volcengine Ark Harness search API key (separate from the chat key)
# Get one at: Volcengine console → Agent Plan → 使用配置 → 配置 Harness → 联网 API Key
ARK_SEARCH_API_KEY=

# Optional: override the default search base URL
# Default: https://open.feedcoopapi.com
# ARK_SEARCH_BASE_URL=

# Aliases (lower priority than ARK_*) — supported for convenience:
# VOLCENGINE_API_KEY=
# VOLCENGINE_BASE_URL=
# ASK_ECHO_SEARCH_INFINITY_API_KEY=    # matches the official Volcengine MCP server var
# VOLCENGINE_SEARCH_API_KEY=
