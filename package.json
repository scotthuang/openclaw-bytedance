{
  "name": "@scotthuang/openclaw-bytedance",
  "version": "0.1.4",
  "description": "OpenClaw plugin for ByteDance Volcengine Ark: web search and image understanding (doubao-seed-2.0-pro)",
  "type": "module",
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/scotthuang/openclaw-bytedance"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "bytedance",
    "volcengine",
    "ark",
    "doubao",
    "web-search",
    "image-understanding",
    "vision"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "types",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "openclaw.plugin.json",
    "openclaw.plugin-search.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "setup:openclaw": "npm install --save-dev --no-save file:${OPENCLAW_REPO:-../openclaw}",
    "build": "tsc -p tsconfig.build.json",
    "build:search": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "compare": "tsx scripts/compare-with-minimax.ts",
    "compare:search": "tsx scripts/compare-with-minimax.ts --only=search",
    "compare:vision": "tsx scripts/compare-with-minimax.ts --only=vision",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
